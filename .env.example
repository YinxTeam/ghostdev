# ghostdev 配置。复制为 .env 后编辑:  cp .env.example .env
# 此处默认不含任何机密。切勿提交你真实的 .env(它已被 gitignore 忽略)。

# ── 容器在宿主机上的发布地址 ────────────────────────────────────────────────
# 安全默认值:仅限本机访问。Web 终端等同于远程 shell —— 除非置于带认证的反向代理之后,
# 否则不要绑定到 0.0.0.0 / 公网接口。
GHOSTDEV_HOST_ADDR=127.0.0.1
GHOSTDEV_HOST_PORT=7680

# ── 应用 ─────────────────────────────────────────────────────────────────────
# 顶栏显示的标签(未设置时默认使用容器主机名)。
GHOSTDEV_NODE_LABEL=ghostdev

# 在顶栏显示你的公网/WAN IP(会调用 api.ipify.org)。设为 false 可禁用。
GHOSTDEV_SHOW_PUBLIC_IP=true

# ── 认证(可选) ───────────────────────────────────────────────────────────────
# 终端内置的 HTTP 基本认证。若不仅限本机/VPN 使用,请留空并改用反向代理 / SSO
# (参见 docs/SECURITY.md)。
# GHOSTDEV_BASIC_AUTH=user:changeme

# 每个标签页运行的命令。默认为每个标签页附加/创建一个 tmux 会话。
# GHOSTDEV_SHELL=tmux new -A -s

# ── 文件浏览器 ─────────────────────────────────────────────────────────────
# 内置文件管理器(侧边栏):浏览、上传、下载、从 URL 下载、
# 重命名、删除、新建文件夹、查看/编辑文本文件。界面还会自动检测
# 浏览器语言(EN/ES/PT/FR),并在顶栏提供语言切换器。
GHOSTDEV_FILES_ENABLED=true
# 文件浏览器限定的根目录(默认为应用用户的主目录)。
# GHOSTDEV_FILES_ROOT=/home/ghost
# 设为 true 则允许浏览/下载,但禁止界面中的所有写操作。
GHOSTDEV_FILES_READONLY=false

# ── 可选的 Proxmox 宿主机统计(默认关闭) ─────────────────────────────────────
# 使用只读的 Proxmox API 令牌,在顶栏添加一个 "host" 分组。
# 切勿使用 root 密码。如何生成令牌请参见 docs/proxmox-stats.md。
# GHOSTDEV_PROXMOX_ENABLED=true
# GHOSTDEV_PROXMOX_HOST=192.0.2.10
# GHOSTDEV_PROXMOX_TOKEN_ID=ghostdev@pve!stats
# GHOSTDEV_PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# GHOSTDEV_PROXMOX_NODE=pve
